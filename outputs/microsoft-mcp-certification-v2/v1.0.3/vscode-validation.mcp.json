{
  "inputs": [
    {
      "id": "certscore-microsoft-application-token",
      "type": "promptString",
      "description": "Short-lived Entra application access token (not a client secret)",
      "password": true
    }
  ],
  "servers": {
    "certscore-microsoft-validation": {
      "type": "http",
      "url": "https://mcp.certscore.ai/mcp/microsoft",
      "headers": {
        "Authorization": "Bearer ${input:certscore-microsoft-application-token}"
      }
    }
  }
}
